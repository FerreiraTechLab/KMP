[Unit]
Description=KMP public catalogue seed node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kmp-seed
Group=kmp-seed
ExecStart=/usr/bin/python3 /usr/local/lib/kmp-seed/kmp_seed_node.py --root /var/lib/kmp-seed --sources /etc/kmp-seed/catalog-sources.txt --public-key /var/lib/kmp-seed/catalog-root.pub --aria2 /usr/local/lib/kmp-seed/kmp-torrentd
Restart=always
RestartSec=10
StateDirectory=kmp-seed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kmp-seed

[Install]
WantedBy=multi-user.target
